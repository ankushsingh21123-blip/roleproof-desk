{
  "name": "roleproof-desk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "test:e2e": "playwright test",
    "test:api": "python3 -m unittest test_api -v",
    "test:worker": "python3 test_worker.py",
    "test:e2e:worker": "playwright test --config playwright.worker.config.ts",
    "dev:worker": "wrangler dev --port 8787 --ip 127.0.0.1"
  },
  "dependencies": {
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.1.0",
    "typescript": "5.9.3",
    "vite": "7.3.8",
    "wrangler": "4.161.0"
  }
}
