{
  "name": "roleproof-desk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node prepare-next.mjs && next dev --hostname 127.0.0.1",
    "build": "node prepare-next.mjs && next build && npm run build:legacy",
    "build:legacy": "node build-legacy.mjs",
    "test:e2e": "playwright test",
    "test:api": "python3 -m unittest test_api -v",
    "test:worker": "python3 test_worker.py",
    "test:e2e:worker": "playwright test --config playwright.worker.config.ts",
    "dev:worker": "wrangler dev --port 8787 --ip 127.0.0.1",
    "test:postgres": "node tests/postgres.mjs && node tests/postgres-http.mjs",
    "start": "next start --hostname 127.0.0.1"
  },
  "dependencies": {
    "next": "16.4.6",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.14",
    "@playwright/test": "1.56.1",
    "@types/node": "^22.0.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "esbuild": "0.28.2",
    "typescript": "5.9.3",
    "wrangler": "4.161.0"
  }
}
